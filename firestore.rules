rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Authenticated users may read and write only under their own path: users/{uid}/**
    match /users/{uid}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // Explicit validation on expense items under users/{uid}/expenses/{expenseId}
    match /users/{uid}/expenses/{expenseId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount < 10000000
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 200
        && request.resource.data.category in ['Food', 'Transport', 'Books', 'Rent', 'Fun', 'Other'];
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Other user subcollections (settings, goals, scholarships, savedJobs)
    match /users/{uid}/{subpath=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // All other paths are strictly denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
